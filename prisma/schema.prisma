generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(cuid())
  stravaId            String      @unique
  accessToken         String
  refreshToken        String
  tokenExpiresAt      DateTime
  maintenanceCalories Int?
  goalType            String      @default("maintain")
  goalAdjustment      Int         @default(0)
  everydayActivity    String      @default("active")
  weight              Float?
  units               String      @default("imperial")
  activities          Activity[]
  foodLogs            FoodLog[]
  savedMeals          SavedMeal[]
  customFoods         Food[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Activity {
  id               String   @id @default(cuid())
  userId           String
  stravaActivityId String   @unique
  name             String
  type             String
  startDate        DateTime
  distance         Float?
  movingTime       Int?
  calories         Float?
  sufferScore      Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  meal      String
  source    String   @default("food")
  foodId    String?
  name      String
  brand     String?
  serving   String
  baseGrams Float
  grams     Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  itemsJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
}

/// Canonical food catalog. Grows over time: seeded USDA generic foods,
/// cache-through inserts from external providers, and user custom foods.
/// FoodLog stays denormalized and does NOT reference this table, so
/// editing or deleting a Food never mutates historical diary entries.
model Food {
  id                  String        @id @default(cuid())
  source              String // "usda" | "off" | "custom" | "seed"
  externalId          String? // FDC id, or GTIN/barcode for Open Food Facts
  name                String
  brand               String?
  barcode             String?
  caloriesPer100g     Float
  proteinPer100g      Float
  carbsPer100g        Float
  fatPer100g          Float
  defaultServingGrams Float         @default(100)
  defaultServingLabel String        @default("100 g")
  createdBy           String? // userId for custom foods; null = public
  verified            Boolean       @default(false)
  usageCount          Int           @default(0)
  servings            FoodServing[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  creator User? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([createdBy])
  @@index([barcode])
  @@index([name])
}

/// Named portions for a Food (e.g. "1 cup (240 g)", "1 slice (28 g)").
/// Every Food has at least a "100 g" serving.
model FoodServing {
  id        String   @id @default(cuid())
  foodId    String
  label     String
  grams     Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

model SavedMeal {
  id              String   @id @default(cuid())
  userId          String
  name            String
  ingredientsJson String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
