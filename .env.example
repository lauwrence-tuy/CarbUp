# Local development and production both use Postgres.
# Neon example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Create an app at https://www.strava.com/settings/api
# This is a numeric value from your Strava API app, for example "123456".
STRAVA_CLIENT_ID="your_numeric_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"

# Local development callback.
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"

# Production callback.
# STRAVA_REDIRECT_URI="https://carb-up-lilac.vercel.app/api/strava/callback"

# Used to build callback URLs.
APP_URL="http://localhost:3000"

# Production app URL.
# APP_URL="https://carb-up-lilac.vercel.app"

# Generate long random values. Keep real values only in .env or your host's
# environment variable settings, never in this example file.
TOKEN_ENCRYPTION_KEY="generate_a_long_random_secret"
SESSION_SECRET="generate_a_different_long_random_secret"
