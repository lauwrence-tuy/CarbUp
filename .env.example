DATABASE_URL="file:./dev.db"

# Create an app at https://www.strava.com/settings/api
# This is a numeric value from your Strava API app, for example "123456".
STRAVA_CLIENT_ID="your_numeric_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"

# Used to build callback URLs in local development.
APP_URL="http://localhost:3000"

# Generate a long random value before token encryption is enabled in the OAuth callback.
TOKEN_ENCRYPTION_KEY="generate_a_long_random_secret"

# Generate a separate long random value for the signed app session cookie.
SESSION_SECRET="generate_a_different_long_random_secret"
